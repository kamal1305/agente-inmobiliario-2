# Copia a `.env` (sin commitear) y rellena. docker compose lo lee automáticamente.
# Si dejas estas variables VACÍAS, la app usa exclusivamente data/config.json.

# Token del bot de Telegram (de @BotFather). Si se define, la auto-alerta se activa sola.
TELEGRAM_BOT_TOKEN=

# IDs de chat (varios separados por comas) o ID de grupo Telegram (-100…)
TELEGRAM_CHAT_ID=

# URL pública del panel (p. ej. https://tudominio.com o https://IP:8000)
# Se añade como enlace "Abrir panel del agente" en cada alerta.
BASE_URL=